# ============================================================
# SLM Gateway Configuration (Port 8000)
# ============================================================

# Service configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false

# LLM backend: "hf_local" (in-process Phi-3) or "openai_compatible" (vLLM / external)
BACKEND=hf_local

# Model ID for the local HuggingFace backend
MODEL_ID=microsoft/Phi-3-mini-4k-instruct

# Quantization: "4bit" or "none" (4bit requires CUDA GPU)
QUANTIZE=4bit
DEVICE=auto
MAX_CONTEXT_LENGTH=4096

# Generation defaults
DEFAULT_MAX_TOKENS=512
DEFAULT_TEMPERATURE=0.7
DEFAULT_TOP_P=1.0

# URL for the openai_compatible backend (used when BACKEND=openai_compatible)
BACKEND_URL=http://localhost:8000
BACKEND_TIMEOUT_SECONDS=120.0

# PII failure mode: "closed" (refuse to start if Presidio fails) or "open"
PII_FAIL_MODE=closed

# Project codename deny-list for PII redaction (comma-separated)
# PROJECT_CODENAMES=Phoenix,Titan,Aurora,Nebula,Valkyrie

# Router configuration
ROUTER_MODEL_NAME=BAAI/bge-small-en-v1.5
ROUTER_THRESHOLD=0.55

# RAG Service integration (in Docker use http://rag:8001)
RAG_SERVICE_URL=http://localhost:8001
RAG_TIMEOUT_SECONDS=30.0
RAG_DEFAULT_STRATEGY=structure

# ============================================================
# RAG Service Configuration (Port 8001)
# ============================================================

# Service configuration
# PORT=8001
# HOST=0.0.0.0

# ChromaDB persistence directory
CHROMA_PERSIST_DIR=data/chroma

# Embedding and Re-ranking models
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
RERANKER_MODEL_NAME=BAAI/bge-reranker-base

# Retrieval defaults
DEFAULT_STRATEGY=structure
RETRIEVE_K=20
FINAL_K=3

# Gateway connection for grounded generation (in Docker use http://gateway:8000)
GATEWAY_URL=http://localhost:8000
GATEWAY_MODEL=microsoft/Phi-3-mini-4k-instruct
GATEWAY_TIMEOUT=30.0
