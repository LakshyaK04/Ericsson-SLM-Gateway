# ============================================================
# SLM Gateway Configuration
# ============================================================

# LLM backend: "hf_local" (in-process Phi-3) or "openai_compatible" (external)
BACKEND=hf_local

# Model ID for the local HuggingFace backend
MODEL_ID=microsoft/Phi-3-mini-4k-instruct

# Quantization: "4bit" or "none" (4bit requires CUDA GPU)
QUANTIZE=4bit

# URL for the openai_compatible backend (used when BACKEND=openai_compatible)
BACKEND_URL=http://localhost:8000/v1

# Optional API key — if set, all requests must include
# Authorization: Bearer <key>
# GATEWAY_API_KEY=

# PII failure mode: "closed" (refuse to start) or "open" (log warning, skip)
PII_FAIL_MODE=closed

# Router similarity threshold (0.0 to 1.0)
ROUTER_THRESHOLD=0.55

# ============================================================
# RAG Service Configuration
# ============================================================

# Gateway URL that the RAG service calls for generation
GATEWAY_URL=http://localhost:8000

# ChromaDB persistence directory
CHROMA_DIR=./chroma_data

# Embedding model
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Reranker model
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
